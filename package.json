{
  "name": "image-processor",
  "version": "1.0.0",
  "description": "离线桌面端批量图片处理工具，基于 React + Tauri + Rust",
  "type": "module",
  "keywords": [
    "image-processing",
    "desktop-app",
    "tauri",
    "rust",
    "react",
    "typescript",
    "image-compression",
    "watermark",
    "image-conversion",
    "crop",
    "resize"
  ],
  "author": "inkdot",
  "license": "MIT",
  "homepage": "https://inkdot.cn",
  "bugs": {
    "url": "https://inkdot.cn"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:tauri": "tauri build",
    "dev:tauri": "tauri dev",
    "release": "npm run tauri build",
    "release:portable": "npm run release && npm run release:zip",
    "release:zip": "powershell -NoProfile -Command \"$root='release/ImageProcessor-1.0.0-portable-win-x64'; New-Item -ItemType Directory -Force -Path $root | Out-Null; Copy-Item src-tauri/target/release/image-processor.exe $root; Copy-Item docs/RELEASE.md $root; Copy-Item LICENSE $root; Compress-Archive -Path $root -DestinationPath release/ImageProcessor-1.0.0-portable-win-x64.zip -Force; Get-Item release/ImageProcessor-1.0.0-portable-win-x64.zip, $root/image-processor.exe | Select-Object Name,Length,LastWriteTime\""
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.8.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "framer-motion": "^10.16.4",
    "i18next": "^25.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^15.6.1",
    "react-icons": "^4.11.0",
    "react-image-crop": "^11.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "typescript": "^5.0.2",
    "vite": "6.0.3"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
