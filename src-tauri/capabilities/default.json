        },
        {
          "path": "$DOWNLOAD"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$PICTURE"
        },
        {
          "path": "$PICTURE/**"
        },
        {
          "path": "$TEMP"
